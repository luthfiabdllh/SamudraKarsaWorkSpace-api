# Salin berkas ini menjadi `.env` lalu isi nilainya.
#
#   cp .env.example .env
#
# `.env` ada di .gitignore dan TIDAK BOLEH pernah di-commit.
# Berkas ini sengaja hanya memuat nama kunci, tanpa satu pun nilai.

# ── Aplikasi ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Dipakai untuk menyusun URI `type` pada respons RFC 7807 (§7.5).
# Keputusan 38: memakai domain Vercel gratis.
API_PUBLIC_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Supabase Postgres, HANYA sebagai database (keputusan 9).
# Gunakan koneksi POOLER, bukan koneksi langsung — bentuk serverless berarti
# banyak koneksi pendek, dan pooler yang menggabungkannya (§7.19.2).
#
# Bentuk: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Menyusul di pass berikutnya ─────────────────────────────────────────────
# JWT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
