# Salin berkas ini menjadi `.env` lalu isi nilainya.
#
#   cp .env.example .env
#
# `.env` ada di .gitignore dan TIDAK BOLEH pernah di-commit.
# Berkas ini sengaja hanya memuat nama kunci, tanpa satu pun nilai.

# ── Aplikasi ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Dipakai untuk menyusun URI `type` pada respons RFC 7807 (§7.5).
# Keputusan 38: memakai domain Vercel gratis.
API_PUBLIC_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Supabase Postgres, HANYA sebagai database (keputusan 9).
# Gunakan koneksi POOLER, bukan koneksi langsung — bentuk serverless berarti
# banyak koneksi pendek, dan pooler yang menggabungkannya (§7.19.2).
#
# Bentuk: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Kunci penanda tangan access token (HS256). Minimal 32 karakter.
#
# Bangkitkan dengan acak — jangan diketik sendiri:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Menggantinya mencabut seluruh sesi yang sedang berjalan, karena setiap access
# token lama berhenti cocok. Itu memang yang diinginkan kalau kuncinya bocor.
JWT_SECRET=

# Client ID OAuth Google. Diambil dari Google Cloud Console.
#
# Bentuknya SELALU berakhiran `.apps.googleusercontent.com`. Kalau yang Anda
# salin tidak berakhiran itu, yang tersalin adalah client *secret* — dan
# menaruhnya di sini akan membuat verifikasi ID token menolak setiap login.
#
# Dipakai sebagai `audience`: ID token yang diterbitkan untuk aplikasi Google
# lain harus ditolak meski tanda tangannya sah.
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET **tidak ada di sini, dan itu disengaja.**
#
# Rahasia itu dipakai untuk menukar authorization code, dan yang menukarnya
# adalah BFF (keputusan 31). Ia milik repo frontend, bukan repo ini. Backend
# hanya menerima ID token yang sudah jadi dan memverifikasinya — pekerjaan yang
# hanya menuntut kunci publik Google.
#
# Menyimpannya di sini juga bukan sekadar tidak perlu: server yang menyimpan
# rahasia yang tidak dipakainya adalah server yang bisa membocorkannya tanpa
# satu pun hal yang didapat.

# ── Menyusul di pass berikutnya ─────────────────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
